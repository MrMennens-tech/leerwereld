# Disable caching for HTML, CSS, JS, and JSON files
# Dit zorgt ervoor dat de server altijd de nieuwste versie stuurt

<IfModule mod_headers.c>
    # HTML - nooit cachen
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    
    # CSS en JavaScript - korte cache (1 uur)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    
    # JSON en Manifest - nooit cachen
    <FilesMatch "\.(json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Zorg dat JavaScript modules het juiste MIME type hebben
<IfModule mod_mime.c>
    AddType text/javascript .js
    AddType application/json .json
    AddType application/manifest+json .webmanifest
</IfModule>

# Sta CORS toe voor modules (indien nodig)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

